{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, overlay and marks windows",
  "windows": ["main", "overlay", "marks"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
